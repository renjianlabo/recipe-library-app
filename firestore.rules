rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }

    match /users/{uid} {
      allow read, create, update, delete: if isVerifiedOwner(uid);

      match /recipes/{recipeId} {
        allow read, delete: if isVerifiedOwner(uid);
        allow create, update: if isVerifiedOwner(uid)
          && request.resource.data.userId == uid
          && request.resource.data.id == recipeId;
      }

      match /drafts/{draftId} {
        allow read, delete: if isVerifiedOwner(uid);
        allow create, update: if isVerifiedOwner(uid)
          && (!('userId' in request.resource.data) || request.resource.data.userId == uid);
      }

      match /settings/{settingsId} {
        allow read, delete: if isVerifiedOwner(uid);
        allow create, update: if isVerifiedOwner(uid)
          && settingsId == 'main';
      }

      match /{otherDocument=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
